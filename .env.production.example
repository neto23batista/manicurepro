# ==========================================================================
# Fernanda Silva Nails — template de ambiente de PRODUÇÃO
# Copie para .env no servidor e preencha. Veja docs/PRODUCAO.md.
# Depois rode: php artisan manicure:verificar-producao
# ==========================================================================

APP_NAME="Fernanda Silva Nails"
APP_ENV=production
APP_KEY=                              # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seudominio.com.br     # PRECISA ser https

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Banco de dados ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manicurepro
DB_USERNAME=
DB_PASSWORD=

# --- Sessão (cookies seguros em https) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# --- Fila e cache ---
QUEUE_CONNECTION=database             # mantenha um worker: php artisan queue:work
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- E-mail (obrigatório para confirmações/lembretes/aniversários) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.seuprovedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Segurança (CSP) ---
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# --- Aniversário (felicitação automática) ---
ANIVERSARIO_ENABLED=true
ANIVERSARIO_CUPOM=true
ANIVERSARIO_CUPOM_TIPO=percentual
ANIVERSARIO_CUPOM_VALOR=15
ANIVERSARIO_CUPOM_VALIDADE=30

# --- Mercado Pago (Pix online) — opcional ---
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
SINAL_HABILITADO=false
SINAL_TIPO=percentual
SINAL_VALOR=30
PAGAMENTO_TOTAL_HABILITADO=false
GORJETA_ONLINE_HABILITADO=false

# --- WhatsApp (Meta Cloud API) — opcional ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_CONFIRMADO=

# --- Web Push (opcional) ---
# Omita WEBPUSH_SUBSCRIBE_UI para auto com VAPID; false força off em prod até validar.
WEBPUSH_SUBSCRIBE_UI=false
VAPID_SUBJECT="mailto:contato@seudominio.com.br"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Sentry (opcional; sem DSN = no-op) ---
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Stubs — manter desligados em produção ---
FISCAL_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
