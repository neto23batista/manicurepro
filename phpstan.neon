parameters:
    level: 5
    paths:
        - app
    excludePaths:
        - app/Console/Kernel.php
    ignoreErrors:
        # Eloquent magic accessors (Laravel-specific dynamic properties)
        - '#Access to an undefined property App\\Models\\.+::\$.+#'
        # Trait method chains com models
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\.+#'
