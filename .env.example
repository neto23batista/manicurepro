APP_NAME="Fernanda Silva Nails"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manicurepro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@manicurepro.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mercado Pago (Pix online) — opcional
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
SINAL_HABILITADO=false
SINAL_TIPO=percentual
SINAL_VALOR=30
PAGAMENTO_TOTAL_HABILITADO=false
GORJETA_ONLINE_HABILITADO=false

# Fidelidade — expiração opcional de pontos (vazio = nunca)
# FIDELIDADE_EXPIRACAO_DIAS=365

# Estoque — limiar padrão no cadastro e alerta ao zerar após venda
ESTOQUE_MINIMO_PADRAO=1
ESTOQUE_NOTIFICAR_ZERADO=true

# Marketing de retenção (reativar inativos / sugerir retorno / pedir avaliação)
MARKETING_ENABLED=true
MARKETING_REATIVAR_COOLDOWN=30
MARKETING_REATIVAR_CUPOM=true
MARKETING_RETORNO_CADENCIA=28
MARKETING_RETORNO_JANELA=3
MARKETING_RETORNO_COOLDOWN=25

# Web Push (PWA) — minishlink/web-push no composer; configure VAPID.
# Omita WEBPUSH_SUBSCRIBE_UI para auto-ligar a UI quando VAPID estiver preenchido.
# WEBPUSH_SUBSCRIBE_UI=false força UI escondida; =true força permitir (ainda precisa VAPID).
# WEBPUSH_SUBSCRIBE_UI=false
VAPID_SUBJECT="mailto:noreply@manicurepro.com.br"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Fiscal / NF-e — stub local (NÃO emite SEFAZ). driver=stub|http
FISCAL_ENABLED=false
FISCAL_DRIVER=stub
# FISCAL_BASE_URL=
# FISCAL_TOKEN=
# FISCAL_TIMEOUT=15
# FISCAL_DRAFT_ENDPOINT=/v2/nfse

# Calendário OAuth (Google / Outlook) — opcional
CALENDAR_GOOGLE_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
# CALENDAR_GOOGLE_REDIRECT="${APP_URL}/perfil/calendario/google/callback"
CALENDAR_OUTLOOK_ENABLED=false
CALENDAR_OUTLOOK_CLIENT_ID=
CALENDAR_OUTLOOK_CLIENT_SECRET=
# CALENDAR_OUTLOOK_REDIRECT="${APP_URL}/perfil/calendario/outlook/callback"

# Sentry (opcional) — sentry/sentry-laravel no composer; sem DSN = no-op
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
